local _shBlockPromptAndPress
do
    local StarterGuiS = game:GetService("StarterGui")
    local VIM         = game:GetService("VirtualInputManager")
    local GuiServiceS = game:GetService("GuiService")
    local cooldowns   = {}

    local function isBlocked(target)
        local ok, res = pcall(function() return LP:IsBlocked(target.UserId) end)
        if ok and res then return true end
        local ok2, list = pcall(function() return StarterGuiS:GetCore("GetBlockedUserIds") end)
        if ok2 and type(list) == "table" then
            for _, id in ipairs(list) do
                if id == target.UserId then return true end
            end
        end
        return false
    end

    local function fastConfirmUntilBlocked(target, timeout)
        local res = GuiServiceS:GetScreenResolution()
        local cx = res.X * 0.5
        local yPoints = { res.Y * 0.64, res.Y * 0.60, res.Y * 0.67, res.Y * 0.62 }  
        local start = tick()
        timeout = timeout or 1.0
        while alive and tick() - start < timeout do
            for _, y in ipairs(yPoints) do
                 
                for _ = 1, 3 do
                    VIM:SendMouseButtonEvent(cx, y, 0, true, game, 0)
                    VIM:SendMouseButtonEvent(cx, y, 0, false, game, 0)
                    task.wait(0.03)
                end
                if isBlocked(target) then return true end
            end
            if isBlocked(target) then return true end
            task.wait(0.05)
        end
        return false
    end

    local function doBlock(target)
        if not alive or not target or target == LP or not target.Parent then return false end

        local now = tick()
        if cooldowns[target.UserId] and now - cooldowns[target.UserId] < 1.5 then
            return false
        end
        cooldowns[target.UserId] = now

        if isBlocked(target) then return true end

        local success = pcall(function()
            StarterGuiS:SetCore("PromptBlockPlayer", target)
        end)
        if not success then return false end

        task.wait(0.1)
        return fastConfirmUntilBlocked(target, 1.5)
    end

    _shBlockPromptAndPress = function(target, waitResult)
        if not alive or not target or target == LP or not target.Parent then return false end
        local function run()
            while alive and _shBlockBusy do task.wait(0.03) end
            if not alive then return false end
            _shBlockBusy = true
            local ok, res = pcall(doBlock, target)
            _shBlockBusy = false
            if not ok then
                showToast("Block: " .. tostring(res), false)
                return false
            end
            if alive then showToast(res==true and ("Blocked @"..target.Name) or ("Could not confirm block for @"..target.Name)) end
            return res == true
        end
        if waitResult then return run() end
        task.spawn(run)
        return true
    end
end

local function _shFindNearestPlayer(maxDistance)
    local character = LP.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local target, nearest = nil, maxDistance or math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = player.Character:FindFirstChildOfClass("Humanoid")
            if targetRoot and targetHum and targetHum.Health > 0 then
                local distance = (targetRoot.Position - root.Position).Magnitude
                if distance <= nearest then nearest, target = distance, player end
            end
        end
    end
    return target
end

local function _shBlockNearest()
    local character = LP.Character
    if not (character and character:FindFirstChild("HumanoidRootPart")) then
        showToast("Block: character not ready", false)
        return
    end
    local target = _shFindNearestPlayer()
    if target then _shBlockPromptAndPress(target) else showToast("Block: player not found", false) end
end

local function _shBlockAll()
    task.spawn(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if not alive then break end
            if player ~= LP and player.Parent then
                _shBlockPromptAndPress(player, true)
                task.wait(0.05)
            end
        end
    end)
end

