        if op.kind=="launcher" then launcherDragged=true end
        local size=op.frame.AbsoluteSize
        local dx=math.clamp(op.absolute.X+delta.X,8,math.max(8,v.X-size.X-8))-op.absolute.X
        local dy=math.clamp(op.absolute.Y+delta.Y,8,math.max(8,v.Y-size.Y-8))-op.absolute.Y
        op.frame.Position=UDim2.new(op.position.X.Scale,op.position.X.Offset+dx,op.position.Y.Scale,op.position.Y.Offset+dy)
    end
end)
