connect(UserInputService.InputChanged,function(input)
    local op=operation
    if not op then return end
    if op.pointer.UserInputType==Enum.UserInputType.Touch then if input~=op.pointer then return end
    elseif input.UserInputType~=Enum.UserInputType.MouseMovement then return end
    local delta=Vector2.new(input.Position.X,input.Position.Y)-op.start
    if delta.Magnitude<3 then return end
    local v=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or viewport
    if op.kind=="resize" then
        local maxW,maxH=math.max(1,v.X-op.absolute.X-8),math.max(1,v.Y-op.absolute.Y-8)
        expanded=UDim2.fromOffset(math.clamp(op.size.X.Offset+delta.X,math.min(250,maxW),maxW),math.clamp(op.size.Y.Offset+delta.Y,math.min(180,maxH),maxH))
